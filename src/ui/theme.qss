/* PLC-HLM industrial touch theme.
 *
 * The visual hierarchy follows the supplied shop-floor HMI references:
 * permanent status at the top, alarm strip below it, fixed navigation and
 * action rails, and a quiet high-contrast work area. All controls retain a
 * minimum 48 px touch target and every state is also expressed as text.
 */

* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 15px;
    color: #17283b;
}

QMainWindow#mainWindow,
QWidget#appSurface,
QWidget#overviewPage,
QWidget#recipeWidthPage,
QWidget#manualControlPage,
QWidget#alarmPage,
QWidget#auditLogPage,
QWidget#diagnosticsPage,
QWidget#usersSettingsPage,
QWidget#adminSettingsContent,
QScrollArea#adminSettingsScroll {
    background-color: #edf2f6;
}

QScrollArea#adminSettingsScroll {
    border: none;
}

/* --- permanent status header --------------------------------------------- */
QWidget#topBar {
    background-color: #0b1d30;
    border-bottom: 1px solid #213a55;
    color: #f8fafc;
}

QWidget#topBar QLabel,
QWidget#topBar QWidget {
    color: #e7eef6;
}

QWidget#topBar QWidget#topStatusLight {
    color: #e7eef6;
}

QLabel#appName {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    padding-right: 2px;
}

QLabel#topBarDivider {
    color: #526b84;
    font-size: 23px;
}

QLabel#pageTitle {
    color: #7fc9ff;
    font-size: 19px;
    font-weight: 700;
    padding-right: 10px;
}

QLabel#userLabel {
    color: #eaf4ff;
    background-color: #173451;
    border: 1px solid #315573;
    border-radius: 4px;
    padding: 8px 13px;
    font-weight: 700;
}

QLabel#clockLabel {
    color: #b8c8d8;
    font-size: 14px;
    padding-left: 4px;
}

/* --- alarm/status strip --------------------------------------------------- */
QWidget#alarmBannerOk {
    background-color: #18814a;
    border-bottom: 2px solid #0e6236;
}

QWidget#alarmBannerActive {
    background-color: #c52b31;
    border-bottom: 2px solid #8f1920;
}

QWidget#alarmBannerOk QLabel,
QWidget#alarmBannerActive QLabel {
    color: #ffffff;
}

QLabel#alarmBannerTag {
    background-color: rgba(0, 0, 0, 35);
    border: 1px solid rgba(255, 255, 255, 75);
    border-radius: 3px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
}

QLabel#alarmBannerText {
    font-size: 17px;
    font-weight: 700;
}

QLabel#alarmBannerSource {
    color: rgba(255, 255, 255, 190);
    font-size: 12px;
}

/* --- left navigation rail ------------------------------------------------- */
QWidget#navPanel {
    background-color: #10263d;
    border-right: 1px solid #203c57;
}

QLabel#navTitle {
    color: #839bb2;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 17px 12px 17px;
}

QListWidget#navList {
    background-color: #10263d;
    color: #dbe7f1;
    border: none;
    outline: none;
    font-size: 16px;
}

QListWidget#navList::item {
    height: 62px;
    padding-left: 16px;
    margin: 2px 8px;
    border: 1px solid transparent;
    border-radius: 3px;
}

QListWidget#navList::item:selected {
    color: #ffffff;
    background-color: #0878b8;
    border-left: 4px solid #64d5ff;
    font-weight: 700;
}

QListWidget#navList::item:hover:!selected {
    color: #ffffff;
    background-color: #1c3b57;
    border-color: #2a4b68;
}

/* --- right action rail ---------------------------------------------------- */
QWidget#actionBar {
    background-color: #dde6ee;
    border-left: 1px solid #bdcad6;
}

QLabel#actionBarTitle {
    color: #293f55;
    font-size: 16px;
    font-weight: 700;
    padding: 4px 0 3px 0;
}

QLabel#actionGroupLabel {
    color: #65778a;
    font-size: 12px;
    font-weight: 700;
    padding: 3px 2px 0 2px;
}

QWidget#actionBar QPushButton {
    min-height: 44px;
    color: #21384e;
    background-color: #f8fbfd;
    border: 1px solid #aebfce;
    border-bottom: 3px solid #9cadbc;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 17px;
    font-weight: 700;
}

QWidget#actionBar QPushButton:hover:enabled {
    background-color: #ffffff;
    border-color: #438ac2;
    border-bottom-color: #2879b7;
}

QPushButton#manualModeButton[active="true"] {
    color: #ffffff;
    background-color: #c47a0a;
    border-color: #9b5d02;
    border-bottom-color: #794801;
}

QPushButton#autoModeButton[active="true"] {
    color: #ffffff;
    background-color: #0878b8;
    border-color: #075f91;
    border-bottom-color: #064b73;
}

QPushButton#startButton[active="true"] {
    color: #ffffff;
    background-color: #17834a;
    border-color: #0f6939;
    border-bottom-color: #0b4e2b;
}

QPushButton#stopButton[active="true"] {
    color: #ffffff;
    background-color: #b76a08;
    border-color: #925304;
    border-bottom-color: #6f3e01;
}

QPushButton#startButton[active="false"] {
    color: #17633b;
    background-color: #e8f6ed;
    border-color: #7fb795;
}

QPushButton#resetButton,
QPushButton#autoModeButton[active="false"] {
    color: #145083;
    background-color: #e8f3fc;
    border-color: #80acd0;
}

QPushButton#stopButton[active="false"] {
    color: #755107;
    background-color: #fff5d9;
    border-color: #d6ae48;
}

/* --- cards and process schematic ----------------------------------------- */
QFrame#overviewSchematic,
QFrame#recipeWidthPanel,
QFrame#recipePanel,
QFrame#manualControlPanel,
QFrame#bypassPanel,
QFrame#userPanel,
QFrame#serialPanel,
QFrame#parameterPanel,
QFrame#loginCard,
QFrame#bootstrapCard,
QFrame#lockedCard {
    background-color: #ffffff;
    border: 1px solid #ccd8e3;
    border-radius: 5px;
}

QLabel#sectionTitle {
    color: #132d46;
    font-size: 18px;
    font-weight: 700;
}

QLabel#valueFieldTitle {
    color: #445d73;
    font-size: 13px;
    font-weight: 600;
    padding-left: 2px;
}

QFrame#schematicNode {
    background-color: #edf7fc;
    border: 1px solid #9fc8de;
    border-bottom: 3px solid #6eabc9;
    border-radius: 4px;
}

QLabel#schematicNodeText {
    color: #174668;
    font-size: 17px;
    font-weight: 700;
}

QLabel#schematicArrow {
    color: #0878b8;
    font-size: 30px;
    font-weight: 700;
}

QLabel#overviewAlarm,
QLabel#shieldBanner,
QLabel#d204Warning {
    color: #6e4a00;
    background-color: #fff2c7;
    border: 1px solid #e1b94c;
    border-left: 5px solid #d49300;
    border-radius: 3px;
    padding: 9px 12px;
    font-weight: 700;
}

/* --- bootstrap / login ---------------------------------------------------- */
QLabel#setupEyebrow,
QLabel#loginEyebrow {
    color: #0878b8;
    font-size: 12px;
    font-weight: 700;
}

QLabel#panelHeroTitle,
QLabel#loginTitle {
    color: #102941;
    font-size: 26px;
    font-weight: 700;
    margin-bottom: 3px;
}

QLabel#setupHint,
QLabel#loginSubtitle {
    color: #627488;
    font-size: 14px;
}

QLabel#setupStep {
    color: #27445f;
    background-color: #eef6fb;
    border: 1px solid #d0e2ee;
    border-radius: 3px;
    padding: 9px 12px;
}

QLabel#lockedIcon {
    color: #0878b8;
    font-size: 48px;
}

QLabel#createAdminStatus[status="error"],
QLabel#userStatus[status="error"],
QLabel#loginStatus,
QLabel#adminPasswordStatus,
QLabel#changePasswordStatus,
QLabel#serialStatus,
QLabel#paramStatus,
QLabel#adjustStatus,
QLabel#manualStatus,
QLabel#auditStatus,
QLabel#alarmStatus {
    color: #aa252b;
    padding: 4px 2px;
}

QLabel#createAdminStatus[status="success"],
QLabel#userStatus[status="success"],
QLabel#loginStatus[status="success"],
QLabel#changePasswordStatus[status="success"] {
    color: #14723f;
    padding: 4px 2px;
}

/* --- controls ------------------------------------------------------------- */
QPushButton {
    min-height: 48px;
    color: #19344d;
    background-color: #ffffff;
    border: 1px solid #aebfce;
    border-bottom: 2px solid #96aaba;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover:enabled {
    background-color: #f2f9fe;
    border-color: #3f8fc7;
}

QPushButton:pressed:enabled {
    background-color: #dceefa;
    border-bottom-width: 1px;
}

QPushButton:focus {
    border: 2px solid #0878b8;
}

QPushButton:disabled {
    color: #8998a7;
    background-color: #e4eaf0;
    border-color: #cdd6df;
}

QPushButton#loginOk,
QPushButton#usersLoginButton,
QPushButton#createAdminButton,
QPushButton#addUserButton,
QPushButton#saveSerialButton,
QPushButton#applyWidthButton,
QPushButton#recipeSaveButton {
    color: #ffffff;
    background-color: #0878b8;
    border-color: #076599;
    border-bottom-color: #064d76;
}

QPushButton#deleteUserButton,
QPushButton#recipeDeleteButton {
    color: #a52228;
    background-color: #fff5f5;
    border-color: #dea4a7;
}

QLineEdit,
QSpinBox,
QComboBox,
QDateEdit {
    min-height: 46px;
    color: #172d42;
    background-color: #ffffff;
    border: 1px solid #aebfce;
    border-radius: 3px;
    padding: 0 11px;
    selection-background-color: #0878b8;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus,
QDateEdit:focus {
    background-color: #fbfdff;
    border: 2px solid #0878b8;
}

QLineEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled {
    color: #8b98a5;
    background-color: #e8edf2;
}

QCheckBox {
    spacing: 9px;
}

QCheckBox::indicator {
    width: 22px;
    height: 22px;
}

/* --- lists and tables ----------------------------------------------------- */
QListWidget#userList,
QListWidget#recipeList,
QTableView {
    color: #21374c;
    background-color: #ffffff;
    alternate-background-color: #f3f7fa;
    border: 1px solid #c8d4df;
    border-radius: 3px;
    gridline-color: #dbe3ea;
    selection-background-color: #d7effc;
    selection-color: #0e456c;
}

QListWidget#userList::item,
QListWidget#recipeList::item {
    min-height: 48px;
    padding: 3px 9px;
    border-bottom: 1px solid #e1e7ed;
}

QHeaderView::section {
    min-height: 46px;
    color: #30475d;
    background-color: #dfe8f0;
    border: none;
    border-right: 1px solid #c5d1dc;
    border-bottom: 1px solid #b9c8d5;
    padding: 6px 8px;
    font-weight: 700;
}

QTableView::item {
    padding: 7px;
}

QScrollBar:vertical {
    width: 18px;
    background-color: #dfe7ee;
    margin: 0;
}

QScrollBar::handle:vertical {
    min-height: 40px;
    background-color: #91a8bb;
    border: 3px solid #dfe7ee;
    border-radius: 7px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QDialog {
    background-color: #edf2f6;
}

QToolTip {
    color: #ffffff;
    background-color: #152c42;
    border: 1px solid #39546e;
    padding: 7px;
}
